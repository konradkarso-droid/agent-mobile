<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Замок экрана агента спрашивает отпечаток или PIN телефона (PresenceLock).
         Без этого разрешения системная проверка не запускается вовсе. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Служба переднего плана (AgentService) — тело агента: держит процесс
         живым постоянно, а на время долгого прогона и процессор проснувшимся. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- С Android 13 без этого разрешения уведомление службы не видно в шторке.
         Служба при этом работает; спрашивать разрешение пока некому. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Подъём тела агента после перезагрузки телефона (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:theme="@style/Theme.UroborosMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".will.TermuxResultService"
            android:exported="false" />

        <!-- Тип specialUse обязателен только с Android 14: вычисление модели на
             устройстве не подходит ни под один из готовых типов. -->
        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on-device language model inference for memory maintenance" />
        </service>

        <!-- Поднимает тело агента после перезагрузки и после установки новой
             сборки. Открыт наружу, потому что оба сообщения шлёт система; чужое
             приложение этих сообщений послать не может, остальные приёмник
             игнорирует. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
