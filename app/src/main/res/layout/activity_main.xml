<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF3F6"
    android:animateLayoutChanges="true"
    android:padding="16dp">

    <!-- Верхняя строка, слева направо: раскрыть подробности — запустить цикл —
         аварийный стоп. Раскладка не декоративная, она разносит действия по
         цене промаха.

         Шторка стоит СЛЕВА: жать её будут часто, а цена ошибки нулевая, и
         левый верх — ближняя точка дуги большого пальца левой руки.

         Стоп остаётся в дальнем правом верхнем углу — самой труднодостижимой
         точке той же дуги. Случайно не нажимается, осознанно дотянуться можно.
         Рядом с ним намеренно не поставлено ничего, что жмут часто.

         "Цикл" — посередине, между ними, и запускается ДОЛГИМ нажатием.
         Общее правило, введённое 27.08.2026: длительность жеста соразмерна
         цене действия. Короткое касание — дешёвое и обратимое, удержание —
         дорогое. Цикл это двадцать минут работы и нагрева, поэтому удержание.
         Защита физическая, а не диалогом "вы уверены?": палец сам чувствует,
         что просят усилие. Условие применимости — жесты должны быть написаны
         на экране (строка подсказок внизу), иначе правило превращается в
         скрытую функцию. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/buttonDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#7FA3AE"
            android:backgroundTint="#EAF3F6"
            android:text="Подробно ▾"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/buttonCycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:text="Цикл"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/buttonStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D6453E"
            android:text="Стоп"/>

    </LinearLayout>

    <!-- Строка модели. Съехала из верхней строки сюда, потому что там теперь
         три кнопки. Осталась однострочной с многоточием: имена файлов моделей
         длинные, а перенос в два этажа возвращал бы ту самую тесноту, ради
         которой всё переставлялось. -->
    <TextView
        android:id="@+id/textModelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="#3A6470"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Модель не загружена"/>

    <!-- Физический контур: зона сторожа, заряд, температура. ВНЕ шторки
         намеренно и навсегда. Это не диагностика, а единственное на экране,
         что говорит о состоянии железа; если спрятать это под свёрнутый
         блок, пропадёт ровно то, ради чего вся видимость и строилась.

         Зона стоит здесь не для красоты: при утомлении мы сами добавляем
         задержку на каждый токен. Если тормозим себя мы, а не железо, это
         должно быть видно на экране, а не выводиться из кода. -->
    <TextView
        android:id="@+id/textHardware"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#3A6470"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:text="Зона: —"/>

    <!-- Ход текущей работы: "идёт генерация", проценты обсчёта запроса.
         Тоже вне шторки, и по той же причине, что и строка железа: пока
         обсчёт длинного запроса идёт три минуты, это единственное, что
         отличает работающую программу от зависшей. Прячется, когда работы
         нет, чтобы не занимать место пустой строкой. -->
    <TextView
        android:id="@+id/textProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#17697B"
        android:fontFamily="monospace"
        android:visibility="gone"/>

    <!-- Шторка. Здесь всё, что нужно при разборе, но мешает при обычной
         работе: параметры движка, потоки, кэш стены, секундомер, память,
         разбивка по стадиям. Раскрывается кнопкой "Подробно" слева вверху,
         состояние запоминается между запусками.

         Почему это вообще прячется. Раскрытая панель занимала десяток строк
         и отъедала высоту у области ответа — той самой, ради которой экран
         и существует. Раньше эти строки были всегда на виду, потому что
         иначе поломки оставались молчаливыми; но молчание лечится не тем,
         что человек постоянно смотрит на цифры, а тем, что важное вынесено
         наружу отдельными строками (см. две выше) и что ошибки называются
         словами в области результата. -->
    <TextView
        android:id="@+id/textMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="#3A6470"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:visibility="gone"/>

    <!-- Причина срабатывания стопа. Скрыт, пока стоп не взведён. Показывается
         из MainActivity вместе с кнопкой сброса (следующий шаг). -->
    <TextView
        android:id="@+id/textStopBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:background="#FBE3E1"
        android:textSize="13sp"
        android:textColor="#A3231D"
        android:visibility="gone"
        android:text="Остановлено"/>

    <EditText
        android:id="@+id/editTextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textSize="14sp"
        android:textColor="#123540"
        android:textColorHint="#7FA3AE"
        android:inputType="textMultiLine"
        android:maxLines="4"
        android:hint="Запрос, текст для сохранения или вопрос агенту"/>

    <!-- Item 9: ответ агента на вопрос, заданный во время идущего TOTE-цикла.
         Отдельная область — не смешивается с textResults (там прогресс цикла).
         Фиолетовая полоса слева: это содержимое другого рода, чем лог. -->
    <TextView
        android:id="@+id/textAnswerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:background="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#5B4B9E"
        android:visibility="gone"
        android:text="Ответ агента"/>

    <TextView
        android:id="@+id/textAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingBottom="8dp"
        android:paddingEnd="10dp"
        android:background="#FFFFFF"
        android:textSize="13sp"
        android:textColor="#123540"
        android:visibility="gone"/>

    <!-- Прокрутка разговора. Имя понадобилось 28.08.2026, когда поле
         результата перестало быть одним ответом и стало лентой: без имени
         из кода нельзя ни доехать до низа при появлении ответа, ни прыгнуть
         на нужный ход.

         Полоска не гаснет (fadeScrollbars=false) намеренно. Она НЕ
         нажимается — в обычном текстовом поле это рисунок, а не ручка, —
         но отвечает на вопрос "где я в разговоре", который на длинной
         ленте возникает постоянно. Точное перемещение делают кнопки хода
         ниже: единица разговора это реплика, а не пиксель. -->
    <ScrollView
        android:id="@+id/scrollResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/textResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#123540"
            android:fontFamily="monospace"/>

    </ScrollView>

    <!-- Кнопки хода. Прыгают на начало предыдущей или следующей реплики
         человека, ставя её под верх экрана.

         Зачем они, если есть взмах. Взмах листает пикселями, а разговор
         состоит из реплик: на ленте в сорок ходов один миллиметр пальца
         это несколько ответов, и попасть в нужное место нельзя в принципе,
         чем длиннее лента, тем хуже. Кнопка промахнуться не может.

         СЛЕВА, потому что телефон держат в левой руке и ось большого
         пальца в нижнем левом углу. Узкие и невысокие: они отнимают
         высоту у самого разговора, а нужны не всегда.

         СКРЫТЫ, пока ходов мало (см. renderTurnNavVisibility в
         MainActivity): на двух-трёх ходах прыгать некуда, а место они
         съедят. Появляются сами, когда лента вырастет. -->
    <LinearLayout
        android:id="@+id/rowTurnNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/buttonTurnPrev"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="12sp"
            android:text="↑ ход"/>

        <Button
            android:id="@+id/buttonTurnNext"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="12sp"
            android:text="↓ ход"/>

    </LinearLayout>

    <!-- Сетка 2x2 вместо столбика: отдаёт высоту области результата.
         Главное действие — в нижней ЛЕВОЙ ячейке: у левши ось большого
         пальца в нижнем левом углу, это ближайшая точка дуги. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <!-- Текст и цвет этой кнопки меняются программно в MainActivity
             (setToteRunningState()) в зависимости от того, идёт ли TOTE-цикл.
             Текст ниже — заглушка на случай, если код не выполнится до
             отрисовки. -->
        <Button
            android:id="@+id/buttonGenerate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#17697B"
            android:enabled="false"
            android:text="Генерировать"/>

        <Button
            android:id="@+id/buttonShow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:text="Показать"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:text="Сохранить"/>

        <Button
            android:id="@+id/buttonLoadModel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:text="Модель"/>

    </LinearLayout>

    <!-- Подсказки о жестах вынесены сюда одной строкой. Раньше они жили внутри
         подписей самих кнопок и заставляли текст переноситься в два этажа.

         Эта строка обязательна, а не украшение: правило "дорогое действие —
         долгим нажатием" работает только пока жесты написаны на экране. Убрать
         её — значит превратить запуск цикла в скрытую функцию. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="#7FA3AE"
        android:text="Долгое нажатие: Цикл — запуск · Показать — лог · Сохранить — экспорт · Модель — папка"/>

</LinearLayout>
