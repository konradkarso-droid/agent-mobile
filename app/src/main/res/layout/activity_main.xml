<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAF3F6"
    android:animateLayoutChanges="true"
    android:padding="16dp">

    <!-- Верхняя строка, слева направо: раскрыть подробности — начать заново —
         аварийный стоп. Раскладка не декоративная, она разносит действия по
         цене промаха.

         Шторка стоит СЛЕВА: жать её будут часто, а цена ошибки нулевая, и
         левый верх — ближняя точка дуги большого пальца левой руки.

         Стоп остаётся в дальнем правом верхнем углу — самой труднодостижимой
         точке той же дуги. Случайно не нажимается, осознанно дотянуться можно.
         Рядом с ним намеренно не поставлено ничего, что жмут часто.

         «Начать заново» — посередине, между ними. Жмут её редко, а промах
         стоит всего разговора (он уходит в архив и в ленту не возвращается),
         поэтому она спрашивает подтверждение — в отличие от «Стоп», тут
         секунда ничего не решает.

         Вид «Начать заново» взят у «Убрать ход», а не у «Стоп»: белая,
         красный текст. Красная заливка в приложении означает одно —
         остановить то, что идёт прямо сейчас; эта кнопка правит уже
         записанное.

         Кнопки запуска TOTE-цикла на экране нет: запускать цикл будет сам
         агент. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/buttonDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#7FA3AE"
            android:backgroundTint="#EAF3F6"
            android:text="Подробно ▾"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/buttonRestart"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#D6453E"
            android:backgroundTint="#FFFFFF"
            android:text="Начать заново"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/buttonStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D6453E"
            android:text="Стоп"/>

    </LinearLayout>

    <!-- Строка модели. Стоит отдельно от верхней строки, потому что там
         три кнопки. Однострочная с многоточием: имена файлов моделей
         длинные, а перенос в два этажа возвращал бы ту самую тесноту, ради
         которой всё переставлялось. -->
    <TextView
        android:id="@+id/textModelStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="#3A6470"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Модель не загружена"/>

    <!-- Физический контур: зона сторожа, заряд, температура. ВНЕ шторки
         намеренно и навсегда. Это не диагностика, а единственное на экране,
         что говорит о состоянии железа; если спрятать это под свёрнутый
         блок, пропадёт ровно то, ради чего вся видимость и строилась.

         Зона стоит здесь не для красоты: при утомлении мы сами добавляем
         задержку на каждый токен. Если тормозим себя мы, а не железо, это
         должно быть видно на экране, а не выводиться из кода. -->
    <TextView
        android:id="@+id/textHardware"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#3A6470"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:text="Зона: —"/>

    <!-- Ход текущей работы: "идёт генерация", проценты обсчёта запроса.
         Тоже вне шторки, и по той же причине, что и строка железа: пока
         обсчёт длинного запроса идёт три минуты, это единственное, что
         отличает работающую программу от зависшей. Прячется, когда работы
         нет, чтобы не занимать место пустой строкой. -->
    <TextView
        android:id="@+id/textProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#17697B"
        android:fontFamily="monospace"
        android:visibility="gone"/>

    <!-- Причина срабатывания стопа. Скрыт, пока стоп не взведён. Показывается
         из MainActivity вместе с кнопкой сброса (следующий шаг). -->
    <TextView
        android:id="@+id/textStopBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="12dp"
        android:background="#FBE3E1"
        android:textSize="13sp"
        android:textColor="#A3231D"
        android:visibility="gone"
        android:text="Остановлено"/>

    <!-- Item 9: ответ агента на вопрос, заданный во время идущего TOTE-цикла.
         Отдельная область — не смешивается с textResults (там прогресс цикла).
         Фиолетовая полоса слева: это содержимое другого рода, чем лог. -->
    <TextView
        android:id="@+id/textAnswerLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:background="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#5B4B9E"
        android:visibility="gone"
        android:text="Ответ агента"/>

    <TextView
        android:id="@+id/textAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingBottom="8dp"
        android:paddingEnd="10dp"
        android:background="#FFFFFF"
        android:textSize="13sp"
        android:textColor="#123540"
        android:visibility="gone"/>

    <!-- Лента и шторка делят одно место: всё, что остаётся между верхом и
         нижним блоком. Видна одна из двух. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <!-- Прокрутка разговора. Имя понадобилось 28.08.2026, когда поле
             результата перестало быть одним ответом и стало лентой: без имени
             из кода нельзя ни доехать до низа при появлении ответа, ни прыгнуть
             на нужный ход.

             Полоска не гаснет (fadeScrollbars=false) намеренно. Она НЕ
             нажимается — в обычном текстовом поле это рисунок, а не ручка, —
             но отвечает на вопрос "где я в разговоре", который на длинной
             ленте возникает постоянно. Точное перемещение делают кнопки хода
             ниже: единица разговора это реплика, а не пиксель. -->
        <ScrollView
            android:id="@+id/scrollResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/textResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#123540"
                android:fontFamily="monospace"/>

        </ScrollView>

        <!-- Шторка. Здесь всё, что нужно при разборе, но мешает при обычной
             работе: параметры движка, потоки, кэш стены, секундомер, память,
             разбивка по стадиям. Раскрывается кнопкой "Подробно" слева вверху,
             состояние запоминается между запусками.

             Шторка встаёт НА МЕСТО ЛЕНТЫ, на ту же высоту, и прокручивается
             своей прокруткой: иначе, раскрытая под лентой, она выталкивала за
             край экрана и ленту, и собственные флажки. Лента в это время только
             спрятана (см. setDetailsExpanded). Флажок — в начале шторки, чтобы
             его было видно сразу, без прокрутки.

             Почему это вообще прячется. Раскрытая панель занимала десяток строк
             и отъедала высоту у области ответа — той самой, ради которой экран
             и существует. Раньше эти строки были всегда на виду, потому что
             иначе поломки оставались молчаливыми; но молчание лечится не тем,
             что человек постоянно смотрит на цифры, а тем, что важное вынесено
             наружу отдельными строками (см. две выше) и что ошибки называются
             словами в области результата. -->
        <ScrollView
            android:id="@+id/scrollDetails"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:background="#FFFFFF"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Настройка «После комы продолжать разговор сам» — в шторке, у правого
                     края. Меняют её раз в жизни, поэтому она не стоит на виду рядом с
                     тем, что жмут часто, и за раскрытием шторки случайно не задевается. -->
                <CheckBox
                    android:id="@+id/checkAutoContinue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textSize="12sp"
                    android:textColor="#3A6470"
                    android:text="После комы продолжать разговор сам"/>

                <TextView
                    android:id="@+id/textMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="11sp"
                    android:textColor="#3A6470"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- Строка хода. Действия НАД ХОДАМИ разговора, в отличие от строки
         кнопок внизу, где действия над приложением. Здесь их три: прыжок к
         предыдущей реплике человека, к следующей и отрезание последнего
         хода.

         Зачем кнопки прыжка, если есть взмах. Взмах листает пикселями, а
         разговор состоит из реплик: на ленте в сорок ходов один миллиметр
         пальца это несколько ответов, и попасть в нужное место нельзя в
         принципе, чем длиннее лента, тем хуже. Кнопка промахнуться не
         может.

         ПРЫЖКИ СЛЕВА, потому что телефон держат в левой руке и ось
         большого пальца в нижнем левом углу. Узкие и невысокие: они
         отнимают высоту у самого разговора, а нужны не всегда.

         ОТРЕЗАНИЕ У ПРАВОГО КРАЯ, и это не симметрия ради вида. Прыжки
         жмут часто, и им место под дугой пальца; отрезание жмут редко, а
         промах по нему стоит хода разговора и восстановить его нечем.
         Разносит их распорка во всю ширину — между ними столько места,
         сколько экран может дать.

         ВИДИМОСТЬ У КАЖДОЙ КНОПКИ СВОЯ (см. renderTurnNavVisibility в
         MainActivity). Прыжки скрыты, пока ходов мало: на двух-трёх
         прыгать некуда, а место они съедят. Отрезание доступно, как
         только в ленте есть хоть один ход — плохой ответ бывает и первым,
         и прятать от него единственное лекарство нельзя. Условия разные,
         и сводить их в одно значило бы спрятать отрезание там, где оно
         нужнее всего.

         Цвета прыжков взяты у второстепенных кнопок (Показать,
         Сохранить): белый фон, тёмно-синий текст. Без них кнопки брали
         системный лиловый — а лиловый в приложении уже занят и означает
         канал речи агента (полоса у поля "Ответ агента"). Служебная
         кнопка прокрутки в этом цвете говорила бы о себе неправду.

         Отрезание красное по тексту, но на белом фоне, а не как "Стоп".
         Красная заливка в приложении означает одно: остановить то, что
         идёт прямо сейчас. Отрезание — другое, оно правит уже
         записанное. Одинаковый вид у двух разных действий стоил бы
         различения, а красный текст оставляет предупреждение. -->
    <LinearLayout
        android:id="@+id/rowTurnNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <Button
            android:id="@+id/buttonTurnPrev"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:text="↑ ход"/>

        <Button
            android:id="@+id/buttonTurnNext"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:text="↓ ход"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/buttonDropTurn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#D6453E"
            android:backgroundTint="#FFFFFF"
            android:text="Убрать ход"/>

    </LinearLayout>

    <!-- Строка мелких кнопок над полем ввода. Действия над приложением, в
         отличие от строки хода выше, где действия над ходами разговора.
         Кнопки мелкие и в одну строку: высота нужна ленте. Ширина у всех
         равная, а шрифт подписи уменьшается сам (autoSize), пока подпись не
         влезет. Ширина по подписи не годилась: при крупном системном шрифте
         сумма подписей шире экрана, и резались все, а длинная «Разбор памяти»
         забирала больше всех. Разрядка букв кнопок по умолчанию снята: на
         мелкой подписи она съедала знак-другой.

         У «Разбора памяти» короткое нажатие показывает уже найденное, долгое
         запускает разбор. Разбор это часы работы и нагрева, а удержание —
         защита от случайного запуска, которая не стоит ни диалога, ни
         лишнего касания. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/buttonShow"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:letterSpacing="0"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:text="Показать"/>

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:letterSpacing="0"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:layout_marginStart="4dp"
            android:text="Сохранить"/>

        <Button
            android:id="@+id/buttonLoadModel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:letterSpacing="0"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:layout_marginStart="4dp"
            android:text="Модель"/>

        <Button
            android:id="@+id/buttonJudge"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:letterSpacing="0"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#123540"
            android:backgroundTint="#FFFFFF"
            android:layout_marginStart="4dp"
            android:text="Разбор памяти"/>

    </LinearLayout>

    <!-- Подсказки о жестах одной строкой, под кнопками. Раньше они жили внутри
         подписей самих кнопок и заставляли текст переноситься в два этажа.

         Эта строка обязательна, а не украшение: правило "дорогое действие —
         долгим нажатием" работает только пока жесты написаны на экране. Убрать
         её — значит превратить долгие нажатия в скрытые функции. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textColor="#7FA3AE"
        android:text="Долгое нажатие: Показать — лог · Сохранить — экспорт · Модель — папка · Разбор — запуск"/>

    <!-- Поле ввода — в самом низу, как в чате, и растёт по высоте с текстом.
         Отправка — стрелкой внутри поля у правого края: у левши большой
         палец держит низ экрана, а стрелка стоит там, где кончается набор.

         Место у ЛЕВОГО края внутри поля оставлено под будущую кнопку «+»
         (добавить документ). Самой кнопки нет: загрузки документов нет, а
         кнопка, которая ничего не делает, хуже её отсутствия.

         Цвет стрелки меняется в MainActivity (setToteRunningState), бледный —
         у погашенной: пока идёт ответ, она недоступна и так и выглядит. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/editTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="44dp"
            android:paddingTop="12dp"
            android:paddingEnd="56dp"
            android:paddingBottom="12dp"
            android:background="#FFFFFF"
            android:textSize="14sp"
            android:textColor="#123540"
            android:textColorHint="#7FA3AE"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:hint="Запрос, текст для сохранения или вопрос агенту"/>

        <ImageButton
            android:id="@+id/buttonSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_send_arrow"
            android:backgroundTint="#C9DAE0"
            android:src="@drawable/ic_send_arrow"
            android:contentDescription="Отправить"
            android:enabled="false"/>

    </FrameLayout>

</LinearLayout>
